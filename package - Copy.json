{
  "name": "pos-kasir-desktop",
  "version": "1.0.0",
  "description": "Aplikasi POS Kasir",
  "author": "RUMAH MAKAN",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "build": {
    "appId": "com.toko.poskasir",
    "productName": "POS Kasir",
    "win": { "target": "nsis", "icon": "build/icon.png" },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.3.0"
  }
}